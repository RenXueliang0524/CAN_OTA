--cpu Cortex-M7.fp.dp
"app2\startup_stm32h743xx.o"
"app2\main.o"
"app2\gpio.o"
"app2\stm32h7xx_it.o"
"app2\stm32h7xx_hal_msp.o"
"app2\stm32h7xx_hal_cortex.o"
"app2\stm32h7xx_hal_rcc.o"
"app2\stm32h7xx_hal_rcc_ex.o"
"app2\stm32h7xx_hal_flash.o"
"app2\stm32h7xx_hal_flash_ex.o"
"app2\stm32h7xx_hal_gpio.o"
"app2\stm32h7xx_hal_hsem.o"
"app2\stm32h7xx_hal_dma.o"
"app2\stm32h7xx_hal_dma_ex.o"
"app2\stm32h7xx_hal_mdma.o"
"app2\stm32h7xx_hal_pwr.o"
"app2\stm32h7xx_hal_pwr_ex.o"
"app2\stm32h7xx_hal.o"
"app2\stm32h7xx_hal_i2c.o"
"app2\stm32h7xx_hal_i2c_ex.o"
"app2\stm32h7xx_hal_exti.o"
