--cpu Cortex-M7.fp.dp
"bootloader\startup_stm32h743xx.o"
"bootloader\main.o"
"bootloader\gpio.o"
"bootloader\stm32h7xx_it.o"
"bootloader\stm32h7xx_hal_msp.o"
"bootloader\function.o"
"bootloader\stm32h7xx_hal_cortex.o"
"bootloader\stm32h7xx_hal_rcc.o"
"bootloader\stm32h7xx_hal_rcc_ex.o"
"bootloader\stm32h7xx_hal_flash.o"
"bootloader\stm32h7xx_hal_flash_ex.o"
"bootloader\stm32h7xx_hal_gpio.o"
"bootloader\stm32h7xx_hal_hsem.o"
"bootloader\stm32h7xx_hal_dma.o"
"bootloader\stm32h7xx_hal_dma_ex.o"
"bootloader\stm32h7xx_hal_mdma.o"
"bootloader\stm32h7xx_hal_pwr.o"
"bootloader\stm32h7xx_hal_pwr_ex.o"
"bootloader\stm32h7xx_hal.o"
"bootloader\stm32h7xx_hal_i2c.o"
